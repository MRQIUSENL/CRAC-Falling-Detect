<!-- 历史记录 -->
<view class="history-page">
  <!-- 头部 -->
  <view class="history-head" wx:if="{{historyList.length > 0}}">
    <text class="text-sm text-secondary">共 {{historyList.length}} 条记录</text>
    <text class="text-sm text-danger" bindtap="clearAll">清空</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{historyList.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-title">暂无检测记录</view>
    <view class="empty-desc">进行图片检测或实时检测后<br/>结果将自动保存在这里</view>
    <button class="btn btn-primary btn-sm mt-32" bindtap="goToDetect">去检测</button>
  </view>

  <!-- 时间线 -->
  <view class="timeline" wx:if="{{historyList.length > 0}}">
    <view class="tl-item" wx:for="{{historyList}}" wx:key="id"
      data-id="{{item.id}}" bindtap="viewDetail">
      <!-- 时间 -->
      <view class="tl-time">{{item.timestamp}}</view>
      <!-- 卡片 -->
      <view class="tl-card">
        <image class="tl-thumb" src="{{item.annotatedImage || item.imageUrl}}" mode="aspectFill"/>
        <view class="tl-info">
          <view class="tl-stats">
            <text class="tl-num">{{item.totalObjects}}</text>
            <text class="tl-unit">个目标</text>
          </view>
          <view class="tl-tags mt-8">
            <text class="tag" style="{{item.params.source === 'camera' ? 'background:#FEF3C7;color:#92400E' : 'background:#EEF1FE;color:#4F6EF7'}}">
              {{item.params.source === 'camera' ? '📹 实时' : '🖼️ 图片'}}
            </text>
            <text class="tag tag-success" wx:if="{{item.counts}}"
              wx:for="{{item.counts}}" wx:for-item="c" wx:for-index="k" wx:key="k">
              {{k}}×{{c}}
            </text>
          </view>
          <text class="tl-meta">{{item.inferenceTimeMs}}ms</text>
        </view>
        <view class="tl-delete" catchtap="deleteItem" data-id="{{item.id}}">✕</view>
      </view>
    </view>
  </view>
</view>
