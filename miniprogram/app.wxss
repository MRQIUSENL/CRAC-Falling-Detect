/* === YOLO11 摔倒检测 - 全局设计系统 === */

/* -- 颜色变量 -- */
page {
  --primary: #4F6EF7;
  --primary-light: #EEF1FE;
  --primary-dark: #3B54D4;
  --success: #10B981;
  --success-light: #ECFDF5;
  --warning: #F59E0B;
  --warning-light: #FFFBEB;
  --danger: #EF4444;
  --danger-light: #FEF2F2;
  --bg: #F0F2F8;
  --card: #FFFFFF;
  --text: #1F2937;
  --text-secondary: #6B7280;
  --text-muted: #9CA3AF;
  --border: #E5E7EB;
  --shadow-sm: 0 1rpx 2rpx rgba(0,0,0,0.04);
  --shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.08);
  --radius-sm: 12rpx;
  --radius: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;

  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
  line-height: 1.6;
}

/* -- 通用容器 -- */
.container { padding: 24rpx; }

/* -- 卡片 -- */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  transition: transform 0.15s;
}

/* -- 圆角卡片变体 -- */
.card-flat {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* -- 按钮 -- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 40rpx;
  border: none;
  transition: all 0.2s;
  line-height: 1.2;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(79, 110, 247, 0.35);
}
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }
.btn-primary[disabled] { opacity: 0.5; box-shadow: none; }

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);
}
.btn-secondary:active { opacity: 0.8; }

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}
.btn-outline:active { background: var(--primary-light); }

.btn-danger {
  background: var(--danger);
  color: #fff;
}
.btn-danger:active { opacity: 0.88; }

.btn-sm { font-size: 26rpx; padding: 14rpx 28rpx; }
.btn-lg { font-size: 34rpx; padding: 26rpx 48rpx; }
.btn-block { width: 100%; }

/* -- 排版 -- */
.text-primary { color: var(--primary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger  { color: var(--danger); }
.text-muted   { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }
.text-center  { text-align: center; }
.text-sm  { font-size: 24rpx; }
.text-lg  { font-size: 32rpx; }
.text-xl  { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }

/* -- 布局 -- */
.flex       { display: flex; }
.flex-row   { display: flex; flex-direction: row; align-items: center; }
.flex-col   { display: flex; flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center   { display: flex; justify-content: center; align-items: center; }
.flex-wrap     { flex-wrap: wrap; }
.flex-1        { flex: 1; }
.gap-8   { gap: 8rpx; }
.gap-12  { gap: 12rpx; }
.gap-16  { gap: 16rpx; }
.gap-20  { gap: 20rpx; }
.gap-24  { gap: 24rpx; }

/* -- 间距 -- */
.mt-8  { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8  { margin-left: 8rpx; }
.ml-12 { margin-left: 12rpx; }
.mr-8  { margin-right: 8rpx; }
.mr-12 { margin-right: 12rpx; }
.p-16 { padding: 16rpx; }
.p-20 { padding: 20rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* -- 标签 -- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}
.tag-primary  { background: var(--primary-light); color: var(--primary); }
.tag-success  { background: var(--success-light); color: var(--success); }
.tag-warning  { background: var(--warning-light); color: var(--warning); }
.tag-danger   { background: var(--danger-light);  color: var(--danger); }

/* -- 徽标数字 -- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-full);
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

/* -- 分割线 -- */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* -- 空状态 -- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

/* -- 加载骨架 -- */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* -- 图片占位 -- */
.img-placeholder {
  background: var(--bg);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}
.img-placeholder:active {
  border-color: var(--primary);
  background: var(--primary-light);
}

/* -- 滑动条 -- */
slider { margin: 0; padding: 0; }

/* -- 渐变文字 -- */
.gradient-text {
  background: linear-gradient(135deg, var(--primary), #8B5CF6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
